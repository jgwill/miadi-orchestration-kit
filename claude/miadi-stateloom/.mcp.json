{
  "mcpServers": {
    "stateloom": {
      "command": "npx",
      "args": [
        "--prefix",
        "${CLAUDE_PLUGIN_ROOT}",
        "-y",
        "-p",
        "${STATELOOM_MCP:-@miadi/stateloom-mcp@0.4.1}",
        "stateloom-mcp"
      ],
      "env": {
        "STATELOOM_BRIDGE_URL": "${STATELOOM_BRIDGE_URL:-http://127.0.0.1:4599}"
      }
    }
  }
}
