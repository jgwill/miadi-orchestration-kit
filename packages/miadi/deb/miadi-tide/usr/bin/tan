#!/usr/bin/env bash
# tan <tmux-target> [options]: review the agent's last reply in that pane and
# deliver the review when you submit. TANS=0 opens it without --submit.
# Options pass through to plannotator-tmux-review (see its --help).
if [ $# -lt 1 ] || [ -z "$1" ]; then
	echo "Usage: tan <tmux-target> [options]" >&2
	exit 64
fi
target=$1
shift
submit=(--submit)
[ "${TANS:-}" = 0 ] && submit=()
exec /usr/bin/plannotator-tmux-review "$target" "${submit[@]}" "$@"
