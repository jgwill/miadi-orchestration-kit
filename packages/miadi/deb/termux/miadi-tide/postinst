#!/data/data/com.termux/files/usr/bin/sh
# The tide runtime gets its own venv (lib/miadi-tide/build-venv.sh): the
# Termux build carries no wheels, pip fetches the pins of requirements.txt
# from PyPI and builds PyYAML from its sdist (jgwill/miadi-orchestration-kit#118).
set -e
prefix=/data/data/com.termux/files/usr
case "$1" in
configure)
	bash "$prefix/lib/miadi-tide/build-venv.sh"
	if ! tmux has-session -t =tide-runtime 2>/dev/null; then
		echo "miadi-tide: start the daemon and its watchdog with: miadi-tide-service ensure" >&2
	fi
	# ironsilk installed by hand beside this package: `pip uninstall ironsilk` would delete
	# this package's bin/tide, because pip installed one at the same path.
	if "$prefix/bin/python3" -m pip show -q ironsilk >/dev/null 2>&1; then
		echo "miadi-tide: ironsilk is also installed with pip. Run: pip uninstall ironsilk && apt install --reinstall miadi-tide" >&2
	fi
	;;
esac
exit 0
