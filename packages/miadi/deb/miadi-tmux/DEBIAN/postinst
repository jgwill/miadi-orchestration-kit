#!/bin/sh
# miadi-tmux postinst: name each user whose tmux server still runs from a tmux this package
# replaced with another release. A client of another release cannot attach to it ("open terminal
# failed: not a terminal"). It only reports: those servers may hold running agents, and each user
# moves them over with what `miadi-terminal enable restore` prints (jgwill/miadi-orchestration-kit#115).
# Nothing a user runs is executed here.
set -e
if [ "$1" = configure ]; then
	current=$(/usr/bin/tmux -V)
	users=
	for exe in /proc/[0-9]*/exe; do
		[ "$(readlink "$exe" 2>/dev/null)" = "/usr/bin/tmux (deleted)" ] || continue
		# The same release (3.7c-2 to 3.7c-3) still attaches: only another release is named. Run as
		# /proc/<pid>/exe, tmux 3.2a names itself "exe 3.2a": keep the last word.
		old=$("$exe" -V 2>/dev/null | awk '{print $NF}') || continue
		{ [ -n "$old" ] && [ "tmux $old" != "$current" ]; } || continue
		user=$(stat -c %U "${exe%/exe}" 2>/dev/null) || continue
		case " $users " in *" $user "*) continue ;; esac
		users="$users $user"
		echo "miadi-tmux: user $user still runs a tmux $old server from the tmux this package replaced, and $current cannot attach to it"
	done
	if [ -n "$users" ]; then
		if command -v miadi-terminal >/dev/null; then
			echo "miadi-tmux: each of them runs 'miadi-terminal enable restore' from a terminal outside tmux:"
			echo "miadi-tmux: it prints the commands that save that server, end it, and start one this tmux restores into"
		else
			echo "miadi-tmux: each of them ends it with 'tmux kill-server' once what it holds is saved, and starts tmux again"
		fi
		echo "miadi-tmux: ending a server ends the agents running in it"
	fi
fi
exit 0
