#!/bin/sh
# The measuring Python gets its own venv, built only from the pinned wheels in
# the package (--no-index): nothing from /usr/local, a user's conda, or PyPI.
# The first Python with venv whose version has wheels in the package is used.
set -e
# Every user runs the measuring tools from this venv, whatever root's umask is.
umask 022
venv=/usr/lib/miadi-music/venv
wheels=/usr/share/miadi-music/wheels
case "$1" in
configure)
	py=
	for c in python3 python3.12 python3.11 python3.10; do
		p=$(command -v "$c" 2>/dev/null) || continue
		tag=$("$p" -c 'import sys; print("cp%d%d" % sys.version_info[:2])' 2>/dev/null) || continue
		"$p" -c 'import ensurepip, venv' 2>/dev/null || continue
		if ls "$wheels"/numpy-*-"$tag"-*.whl >/dev/null 2>&1; then py=$p; break; fi
	done
	if [ -z "$py" ]; then
		echo "miadi-music-measure: no Python with venv for the bundled wheels ($(ls "$wheels" | sed -n 's/^numpy-[^-]*-\(cp[0-9]*\)-.*/\1/p' | sort -u | tr '\n' ' '))" >&2
		exit 1
	fi
	rm -rf "$venv"
	"$py" -m venv "$venv"
	PIP_DISABLE_PIP_VERSION_CHECK=1 "$venv/bin/pip" install -q --no-cache-dir --no-index \
		--find-links "$wheels" -c "$wheels/constraints.txt" numpy scipy pillow
	# The pair must import without a compatibility warning and run scipy.signal.
	"$venv/bin/python3" -W error -c 'import numpy, PIL; from scipy.signal import find_peaks; assert find_peaks(numpy.array([0.0, 1.0, 0.0]))[0].tolist() == [1]'
	echo "miadi-music-measure: $("$venv/bin/python3" -c 'import numpy, scipy, PIL; print("numpy", numpy.__version__, "scipy", scipy.__version__, "pillow", PIL.__version__)') in $venv ($("$py" -V 2>&1))" >&2
	;;
esac
exit 0
