#!/bin/sh
set -eu
case "$1" in configure)
    base=/usr/lib/miadi-deepdiver
    abi=$(/usr/bin/python3 -c 'import sys; print("cp%d%d" % sys.version_info[:2])')
    share=/usr/share/miadi-deepdiver
    test -f "$share/$abi.txt" || { echo "Unsupported Python ABI: $abi (3.10-3.12 supported)" >&2; exit 1; }
    umask 022
    rm -rf "$base/venv.new"
    /usr/bin/python3 -m venv "$base/venv.new"
    PIP_CONFIG_FILE=/dev/null PIP_NO_INDEX=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
      "$base/venv.new/bin/python" -m pip install --no-index --no-deps --no-compile --require-hashes \
      --find-links "$share/wheels" -r "$share/$abi.txt"
    "$base/venv.new/bin/python" -I -c 'import deepdiver.deepdive, playwright, yaml'
    rm -rf "$base/venv.old"
    if [ -d "$base/venv" ]; then mv "$base/venv" "$base/venv.old"; fi
    mv "$base/venv.new" "$base/venv"
    rm -rf "$base/venv.old"
    echo 'DeepDiver installed. As your desktop user: miadi-deepdiver setup --claude'
    echo 'SIGN-IN NEEDED: Google sign-in is manual, never performed by apt.'
;; esac
