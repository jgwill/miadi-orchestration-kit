#!/bin/sh
set -eu
export PLAYWRIGHT_BROWSERS_PATH=/usr/lib/miadi-deepdiver/browsers
export CHROME_DEVEL_SANDBOX=$PLAYWRIGHT_BROWSERS_PATH/chromium-1248/chrome-linux64/chrome_sandbox
export PATH=/usr/lib/miadi-deepdiver/bin:$PATH
# Run outside a checkout, ignoring PYTHONPATH and user site-packages.
exec /usr/lib/miadi-deepdiver/venv/bin/python -I /usr/lib/miadi-deepdiver/entry.py "$@"
