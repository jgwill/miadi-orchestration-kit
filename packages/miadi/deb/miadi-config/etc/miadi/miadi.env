# /etc/miadi/miadi.env — this host's Miadi values.
#
# Plain KEY=VALUE, one per line: no `export`, no $VAR, no shell code, and
# comments only on their own line. systemd EnvironmentFile=, docker compose
# env_file and /usr/share/miadi/env.sh all read this file.
#
# No secrets here. A user's client tokens go in that user's ~/.env.
#
# A variable already in the environment wins over this file; this file wins
# over the defaults in /usr/share/miadi/env.sh. Uncomment what differs here.

# Layout
#MIADI_OPT_DIR=/opt
#MIADI_WORK_DIR=/workspace
#MIADI_REPOS_ROOT=/workspace/repos
#MIADI_SRC=/src/Miadi
#MIADI_DATA_DIR=/srv/miadi
#MIADI_SESSIONDATA_ROOT=/src/_sessiondata
#MIADI_STORIES_ROOT=/workspace/repos/jgwill/miadi-passages

# Public and tailnet URLs
#MIADI_URL_BASE=https://your-host.ngrok-free.app
#MIADI_URL_BASE_INTERNAL=https://miadi.your-tailnet.ts.net
#MIADI_API_URL_DEFAULT=http://127.0.0.1:3335
#MIADI_INQUIRY_URL_BASE=https://iaip.your-tailnet.ts.net
#MIADI_PI_NETWORK_URL=https://pi.your-tailnet.ts.net

# Local services
#MIADI_CHRONICLE_MW_URL=http://127.0.0.1:8040
#MIADI_INQUIRY_API_BASE=http://127.0.0.1:3335
